{
  "name": "marketplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc && vite build client --outDir dist --emptyOutDir",
    "start": "node dist/server/db/migrate.js && node dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx server/db/migrate.ts",
    "test:concurrency": "tsx server/__tests__/integration/concurrency-http.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cd client && npx playwright test",
    "lint": "eslint .",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/middleware-flexible-checksums": "^3.974.54",
    "@hono/node-server": "^1.13.8",
    "@sentry/node": "^10.70.0",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "dompurify": "^3.4.14",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^11.0.2",
    "hono": "^4.7.5",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "otplib": "^12.0.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "resend": "^6.22.1",
    "sharp": "^0.35.3",
    "twilio": "^6.1.0",
    "uuid": "^11.1.0",
    "xss": "^1.0.15",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/otplib": "^7.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.4"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "tar": "^7.5.22"
  }
}
