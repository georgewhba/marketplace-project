# Environment Variables — Marketplace
# Copy to .env and fill in real values

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/marketplace

# JWT Secrets (generate unique random strings, 32+ chars)
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_32chars_min
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_32chars_min
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Seed defaults (change before any real deployment)
SEED_ADMIN_EMAIL=admin@marketplace.com
SEED_ADMIN_PASSWORD=Admin@123456

# MFA & Security
MFA_ENCRYPTION_KEY=CHANGE_ME_32_byte_encryption_key_min

# Paymob
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC=

# Shipping (Bosta)
BOSTA_API_KEY=
BOSTA_WEBHOOK_SECRET=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Redis & Queues
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email (Brevo / Resend / SMTP)
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=noreply@marketplace.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# OAuth & AI
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_JURISDICTION=

# Monitoring
SENTRY_DSN=
